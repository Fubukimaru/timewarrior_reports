#!/usr/bin/env python3
"""Run the tag totals extension without Timewarrior filtering its input."""
import json
import os
import re
import subprocess
import sys


def arguments(args):
    if "--" in args:
        separator = args.index("--")
        period, tags = args[:separator], args[separator + 1:]
        if not period:
            raise ValueError("Provide a range before --")
    elif args and args[0].startswith(":"):
        period, tags = args[:1], args[1:]
    elif args and re.match(r"^\d{4}-\d\d-\d\d", args[0]):
        length = 3 if len(args) >= 3 and args[1] in ("-", "to") else 1
        period, tags = args[:length], args[length:]
    else:
        period, tags = [":week"], args
    if not tags or any(not tag for tag in tags):
        raise ValueError("Provide at least one tag")
    return period, tags


def main():
    if sys.argv[1:] in (["-h"], ["--help"]):
        print("Usage: timew-tags [pie_chart] [RANGE] TAG...\n"
              "For multiword ranges, use: timew-tags RANGE... -- TAG...\n"
              "Default range: :week")
        return 0
    try:
        args = sys.argv[1:]
        chart = bool(args and args[0] == "pie_chart")
        period, tags = arguments(args[1:] if chart else args)
        env = dict(os.environ, TIMEW_REPORT_REQUESTED_TAGS=json.dumps(tags),
                   TIMEW_REPORT_TAG_VIEW="pie" if chart else "text")
        return subprocess.run(["timew", "report", "tag_totals", *period], env=env).returncode
    except (ValueError, OSError) as error:
        print(f"timew-tags: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
